# Copy this file to .env.local and fill in your keys. .env.local is gitignored.
# Restart `npm run dev` after changing it.

# Primary provider - https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Fallback provider, used when Groq fails or is rate-limited - https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
